{
  "name": "rp-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run i18n:validate && next build",
    "start": "next start",
    "lint": "eslint",
    "i18n:sanitize": "node scripts/sanitize-overlays.mjs",
    "i18n:merge": "node scripts/sanitize-overlays.mjs && node scripts/merge-section-overlays.mjs",
    "i18n:audit": "node scripts/audit-locale-language.mjs --messages",
    "i18n:sync": "node scripts/sync-i18n-structure.mjs",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "i18n:check": "npm run i18n:merge && npm run i18n:validate && npm run i18n:audit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
